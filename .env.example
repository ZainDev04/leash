# Copy this file to .env and fill in the values. Never commit .env.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
LLM_API_KEY=
# Gemini models, tried in order. Each has its own free daily quota, so the next one is used when one runs out.
LLM_MODEL=gemini-3.5-flash,gemini-3.1-flash-lite
# Public address of this server, used for the PayPal return link. Change when hosted.
PUBLIC_URL=http://localhost:8000
# Dashboard password, at least 12 characters. With no password nobody can log in.
LEASH_ADMIN_PASSWORD=
# One key per agent, as name:key,name:key. Make a key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
LEASH_AGENT_KEYS=
# The key agents/demo_shopper.py uses, one of the keys above.
LEASH_API_KEY=
