# Copy this file to .env and fill in the values. Never commit .env.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
LLM_API_KEY=
# Gemini models, tried in order. Each has its own free daily quota, so the next one is used when one runs out.
LLM_MODEL=gemini-3.5-flash,gemini-3.1-flash-lite
# Public address of this server, used for the PayPal return link. Change when hosted.
PUBLIC_URL=http://localhost:8000
# Dashboard password, at least 12 characters. With no password nobody can log in.
LEASH_ADMIN_PASSWORD=
# One key per agent, as name:key,name:key. Make a key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
LEASH_AGENT_KEYS=
# The key agents/demo_shopper.py and agents/shopper.py use, one of the keys above.
LEASH_API_KEY=
# Stores Leash may fetch pages from, as host:port,host:port. When this is set, a payment
# without a page Leash could read itself waits for the user. Add your hosted address when you deploy.
LEASH_VERIFIED_STORES=localhost:8000
